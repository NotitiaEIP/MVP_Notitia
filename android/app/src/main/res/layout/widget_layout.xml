<?xml version="1.0" encoding="utf-8"?>
<!-- =============================================================================
     NOTITIA — Widget PETIT (2×2) — État IDLE
     Micro compact centré + label minimal.
     ============================================================================= -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/widget_background"
    android:padding="6dp">

    <!-- Conteneur bouton micro + glow ring -->
    <FrameLayout
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:layout_gravity="center">

        <ImageView
            android:id="@+id/widget_glow_ring"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_glow_ring"
            android:contentDescription="Halo néon"
            android:scaleType="fitCenter" />

        <ImageView
            android:id="@+id/widget_mic_button"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_mic_widget"
            android:contentDescription="Capture vocale"
            android:scaleType="centerInside" />

    </FrameLayout>

    <!-- Label compact -->
    <TextView
        android:id="@+id/widget_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="4dp"
        android:text="NOTITIA"
        android:textColor="#FFFF0178"
        android:textSize="11sp"
        android:fontFamily="sans-serif-medium"
        android:textStyle="bold"
        android:letterSpacing="0.2"
        android:shadowColor="#AAFF0178"
        android:shadowRadius="8"
        android:shadowDx="0"
        android:shadowDy="0" />

</LinearLayout>
