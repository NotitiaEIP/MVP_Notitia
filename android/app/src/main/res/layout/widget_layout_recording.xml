<?xml version="1.0" encoding="utf-8"?>
<!-- =============================================================================
     NOTITIA — Widget Écran d'Accueil (Android) — État RECORDING
     Timer + bouton stop — Centré, gros, impactant.
     ============================================================================= -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/widget_background_recording"
    android:padding="8dp">

    <!-- Conteneur bouton stop + glow ring empilés -->
    <FrameLayout
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_gravity="center">

        <!-- Glow extérieur rouge (halo pulsant) -->
        <ImageView
            android:id="@+id/widget_glow_ring_rec"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_glow_ring_recording"
            android:contentDescription="Halo enregistrement"
            android:scaleType="fitCenter" />

        <!-- Bouton STOP -->
        <ImageView
            android:id="@+id/widget_stop_button"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_stop_widget"
            android:contentDescription="Arrêter l'enregistrement"
            android:scaleType="centerInside" />

    </FrameLayout>

    <!-- Label "● REC" -->
    <TextView
        android:id="@+id/widget_rec_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="4dp"
        android:text="● REC"
        android:textColor="#FFFF3366"
        android:textSize="13sp"
        android:fontFamily="sans-serif-bold"
        android:letterSpacing="0.15"
        android:shadowColor="#CCFF3366"
        android:shadowRadius="10"
        android:shadowDx="0"
        android:shadowDy="0" />

    <!-- Timer (durée d'enregistrement) -->
    <TextView
        android:id="@+id/widget_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="2dp"
        android:text="00:00"
        android:textColor="#FF00E5FF"
        android:textSize="18sp"
        android:fontFamily="sans-serif-medium"
        android:textStyle="bold"
        android:letterSpacing="0.12"
        android:shadowColor="#AA00E5FF"
        android:shadowRadius="12"
        android:shadowDx="0"
        android:shadowDy="0" />

</LinearLayout>
