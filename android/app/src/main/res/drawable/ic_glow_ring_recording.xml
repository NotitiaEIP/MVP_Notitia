<?xml version="1.0" encoding="utf-8"?>
<!-- Halo rouge intense autour du bouton stop (état recording) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Glow externe large -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#22FF3366" />
        </shape>
    </item>
    <!-- Glow moyen -->
    <item android:left="6dp" android:top="6dp" android:right="6dp" android:bottom="6dp">
        <shape android:shape="oval">
            <solid android:color="#35FF3366" />
        </shape>
    </item>
    <!-- Glow interne -->
    <item android:left="12dp" android:top="12dp" android:right="12dp" android:bottom="12dp">
        <shape android:shape="oval">
            <solid android:color="#28FF3366" />
        </shape>
    </item>
    <!-- Anneau rouge néon vif -->
    <item android:left="16dp" android:top="16dp" android:right="16dp" android:bottom="16dp">
        <shape android:shape="oval">
            <stroke android:width="2.5dp" android:color="#BBFF3366" />
            <solid android:color="#10FF3366" />
        </shape>
    </item>
</layer-list>
