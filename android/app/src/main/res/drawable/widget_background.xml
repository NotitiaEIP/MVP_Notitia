<?xml version="1.0" encoding="utf-8"?>
<!-- Background du widget IDLE — Deep Blue, glow néon rose spectaculaire -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Glow externe diffuse rose (couche 3 — la plus large) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="#22FF0178" />
        </shape>
    </item>
    <!-- Glow externe rose (couche 2) -->
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="#33FF0178" />
        </shape>
    </item>
    <!-- Fond principal (opaque) -->
    <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:startColor="#F0000830"
                android:centerColor="#F0000520"
                android:endColor="#F000003F"
                android:angle="135" />
            <stroke
                android:width="1.5dp"
                android:color="#80FF0178" />
        </shape>
    </item>
</layer-list>
