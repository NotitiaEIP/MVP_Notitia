# Copier ce fichier en `.env` (jamais commité) puis remplir.

# Clé admin de la passerelle (doit commencer par "sk-").
# Générer : echo "sk-$(openssl rand -hex 24)"
LITELLM_MASTER_KEY=sk-change-me

# Mot de passe de la base Postgres interne.
# Générer : openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# Clés des fournisseurs
DEEPINFRA_API_KEY=
BRAVE_API_KEY=

# Uniquement pour le profil https (VPS) : sous-domaine pointant vers le serveur
# ex. notitia-ai.duckdns.org
DOMAIN=
# Sur un VPS avec le profil https, ne pas exposer le port 4000 directement :
# LITELLM_BIND=127.0.0.1

# Interface d'admin LiteLLM (http://<hôte>:4000/ui) — identifiants
UI_USERNAME=admin
UI_PASSWORD=change-me
