<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>NSSupportsLiveActivities</key>
		<true/>
		<!-- ============================================== -->
		<!-- PERMISSIONS NOTITIA - Microphone + Bluetooth  -->
		<!-- ============================================== -->
		<!-- Permission Caméra - Scanner QR code réunion -->
		<key>NSCameraUsageDescription</key>
		<string>Notitia utilise la caméra pour scanner les QR codes et rejoindre des réunions.</string>
		<!-- Permission Microphone - Enregistrement audio -->
		<key>NSMicrophoneUsageDescription</key>
		<string>Notitia a besoin d'accéder au microphone pour enregistrer vos notes vocales et mémos audio.</string>
		<!-- Permission Réseau local - Réunions en local -->
		<key>NSLocalNetworkUsageDescription</key>
		<string>Notitia utilise le réseau local pour héberger et rejoindre des réunions entre appareils sur le même Wi-Fi.</string>
		<!-- Bonjour - Requis pour Flutter debug sur device physique -->
		<key>NSBonjourServices</key>
		<array>
			<string>_dartVmService._tcp</string>
		</array>
		<!-- Permission Bluetooth - Scan et connexion BLE -->
		<key>NSBluetoothAlwaysUsageDescription</key>
		<string>Notitia utilise le Bluetooth pour se connecter au Notitia Node et synchroniser vos données.</string>
		<key>NSBluetoothPeripheralUsageDescription</key>
		<string>Notitia utilise le Bluetooth pour détecter et communiquer avec le Notitia Node.</string>
		<!-- ============================================== -->
		<!-- NFC SHARING (uniquement)                      -->
		<!-- ============================================== -->
		<!-- NFC - Lecture/écriture de tags pour le tap-to-share -->
		<key>NFCReaderUsageDescription</key>
		<string>Notitia utilise le NFC pour lire et écrire des transcriptions sur des tags NFC.</string>
		<!-- ============================================== -->
		<!-- SPEECH RECOGNITION                            -->
		<!-- ============================================== -->
		<!-- Permission reconnaissance vocale (natif STT) -->
		<key>NSSpeechRecognitionUsageDescription</key>
		<string>Notitia utilise la reconnaissance vocale pour transcrire vos notes audio en texte.</string>
		<!-- ============================================== -->
		<!-- Configuration standard de l'application       -->
		<!-- ============================================== -->
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>Notitia</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>notitia</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
		</array>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<key>UIStatusBarHidden</key>
		<false/>
		<!-- Autoriser les connexions HTTP locales (serveur réunion) -->
		<key>NSAppTransportSecurity</key>
		<dict>
			<key>NSAllowsLocalNetworking</key>
			<true/>
		</dict>
		<!-- Deep link pour OAuth Supabase -->
		<key>CFBundleURLTypes</key>
		<array>
			<dict>
				<key>CFBundleTypeRole</key>
				<string>Editor</string>
				<key>CFBundleURLSchemes</key>
				<array>
					<string>notitia</string>
				</array>
			</dict>
		</array>
		<key>BGTaskSchedulerPermittedIdentifiers</key>
		<array>
			<string>com.pravera.flutter_foreground_task.refresh</string>
		</array>
		<key>UIBackgroundModes</key>
		<array>
			<string>audio</string>
			<string>fetch</string>
			<string>remote-notification</string>
			<string>processing</string>
		</array>
		<key>com.apple.developer.nfc.readersession.iso7816.select-identifiers</key>
		<array>
			<string>A0000002471001</string>
		</array>
	</dict>
</plist>
