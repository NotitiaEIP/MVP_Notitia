<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<!-- ============================================== -->
		<!-- PERMISSIONS NOTITIA - Microphone + Bluetooth  -->
		<!-- ============================================== -->
		<!-- Permission Microphone - Enregistrement audio -->
		<key>NSMicrophoneUsageDescription</key>
		<string>Notitia a besoin d'accéder au microphone pour enregistrer vos notes vocales et mémos audio.</string>
		<!-- Permission Bluetooth - Scan et connexion BLE -->
		<key>NSBluetoothAlwaysUsageDescription</key>
		<string>Notitia utilise le Bluetooth pour se connecter au Notitia Node et synchroniser vos données.</string>
		<key>NSBluetoothPeripheralUsageDescription</key>
		<string>Notitia utilise le Bluetooth pour détecter et communiquer avec le Notitia Node.</string>
		<!-- ============================================== -->
		<!-- NFC + P2P SHARING                             -->
		<!-- ============================================== -->
		<!-- NFC - Lecture de tags pour le tap-to-share -->
		<key>NFCReaderUsageDescription</key>
		<string>Notitia utilise le NFC pour initier le partage de transcriptions par proximité.</string>
		<!-- Réseau local - MultipeerConnectivity -->
		<key>NSLocalNetworkUsageDescription</key>
		<string>Notitia utilise le réseau local pour transférer des transcriptions entre appareils proches.</string>
		<!-- Bonjour - Services MultipeerConnectivity -->
		<key>NSBonjourServices</key>
		<array>
			<string>_notitia-share._tcp</string>
			<string>_notitia-share._udp</string>
		</array>
		<!-- ============================================== -->
		<!-- Configuration standard de l'application       -->
		<!-- ============================================== -->
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>Notitia</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>notitia</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<key>UIStatusBarHidden</key>
		<false/>
	</dict>
</plist>
